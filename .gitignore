# 忽略 '中电信' 目录下的所有内容
中电信/*

# 忽略 'results' 目录
results/

# Local/private revision workspace and audit artifacts
.env
paper_revisions/
codex_audits/

# Build and packaging artifacts
experiments/build/
*.egg-info/

# 忽略 Python 编译生成的文件
*.pyc
*.pyo
__pycache__/

# 忽略测试相关的缓存文件
.pytest_cache/

# 忽略编辑器配置文件
.vscode/
.editorconfig

# 忽略 Git 配置文件
.git-blame-ignore-revs
.gitattributes

# 忽略日志文件
*.log

# 忽略临时文件
*.swp
*.bak
*.tmp

# 忽略 Jupyter Notebook 的检查点文件
.ipynb_checkpoints/

# 忽略一些输出文件（如实验结果、输出文本）
experiment_results.txt
output_circuit.txt

# 忽略其他不需要的文件
*.tsv
*.csv

# Keep the official Paper 2026 reproduction outputs.
!results/
results/*
!results/paper_2026/
results/paper_2026/*
